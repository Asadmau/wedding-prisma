# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL / Neon
# Runtime connection (pooled URL from Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Prisma migrations connection (direct / unpooled URL from Neon)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Admin bootstrap (set both in production)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_RANDOM_PASSWORD_AT_LEAST_12_CHARS"
SESSION_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARS"
SESSION_TTL_HOURS=24

# Persistent media storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional AI integration
GEMINI_API_KEY=""

# Tests: use a dedicated, disposable PostgreSQL database
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/TEST_DB?sslmode=require"
